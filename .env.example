NODE_ENV=development
PORT=3000
# MongoDB Atlas connection strings. URL-encode special characters in the username/password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/nhuu-chat?retryWrites=true&w=majority
# Optional: use a separate Atlas database for integration tests before the in-memory fallback.
MONGODB_TEST_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/nhuu-chat-test?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-characters
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Facebook Page publishing V1 (Page ID/token are entered in the web app).
META_GRAPH_API_VERSION=v26.0
FACEBOOK_POST_SCHEDULER_INTERVAL_MS=30000
FACEBOOK_POST_LEASE_MS=120000
# Required only for Telegram personal QR login; create these at https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WEB_ALLOWED_ORIGINS=http://localhost:5173
# Production cross-origin frontend/API: set to "none" and serve both sides over HTTPS.
AUTH_COOKIE_SAME_SITE=lax
