NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nhuu-chat?replicaSet=rs0
# Optional: integration tests prefer this external replica-set URI before the in-memory fallback.
MONGODB_TEST_URI=mongodb://localhost:27017/nhuu-chat-test?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-characters
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
WEB_ALLOWED_ORIGINS=http://localhost:5173
